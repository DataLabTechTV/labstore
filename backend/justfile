[group("test-iam")]
test-iam-add-user-to-group: check-deps
    #!/bin/bash
    echo "Adding IAM user {{test_user}} to group {{test_group}}"
    host=$(yq ".backend.iam.server.host" {{config_path}})
    port=$(yq ".backend.iam.server.port" {{config_path}})
    http POST "http://${host}:${port}" \
        "Action==AddUserToGroup" \
        'GroupName=={{test_group}}' \
        'UserName=={{test_user}}'

[group("test-iam")]
test-db-delete-user-from-group: check-deps
    #!/bin/bash
    echo "Deleting IAM user {{test_user}} from group {{test_group}}"
    iam_db=../$(yq ".backend.storage.data_dir" {{config_path}})/metadata/iam.db
    sqlite3 $iam_db "DELETE FROM group_users \
        WHERE group_id = (SELECT group_id FROM groups WHERE name = '{{test_group}}') \
        AND user_id = (SELECT user_id FROM users WHERE name = '{{test_user}}')"

