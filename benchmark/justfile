set shell := ["bash", "-uc"]

iperf3_dir := "iperf3/"

warp_dir := "warp/"
warp_bucket := "warp-benchmark-bucket"

analysis_dir := "analysis/"
analysis_db := join(analysis_dir, "output/analysis.duckdb")

default:
    just -l

[working-directory: ".."]
check-deps:
    #!/bin/bash
    echo "Checking system binary dependencies for benchmark..."
    just check yq
    just check docker
    just check iperf3
    just check warp
    just check duckdb
    just check termgraph

[working-directory: ".."]
check-garage:
    @just check-container labstore-benchmark-garage-1

[group("bandwidth")]
bandwidth: check-deps
    #!/bin/bash

    eval $(cd .. && just print-env)

    echo -n "Measuring bandwidth with iperf3... "

    mkdir -p {{join(iperf3_dir, "output")}}
    iperf3 -c $BENCHMARK_HOST -p $BENCHMARK_PORTS_IPERF3 -t 30 -J \
        | gzip > {{join(iperf3_dir, "output")}}/$(date +%Y_%m_%d-%H_%M).json.gz

    echo "done"

[group("helpers")]
garage-init: check-deps check-garage
    #!/bin/bash -e
    garage_cmd="docker exec labstore-benchmark-garage-1 /garage"

    echo "Waiting for Garage to be ready..." >&2
    while ! $garage_cmd status >/dev/null 2>&1; do
        sleep 1
    done

    if $garage_cmd status 2>/dev/null | grep -q "NO ROLE ASSIGNED"; then
        echo "Applying initial layout..." >&2
        node_id=$($garage_cmd status 2>/dev/null | tail -n1 | awk '{print $1}')
        $garage_cmd layout assign $node_id --capacity 5G -z $BENCHMARK_STORE_REGION >/dev/null 2>&1
        $garage_cmd layout apply --version 1 >/dev/null 2>&1
    else
        echo "Layout already applied; skipping." >&2
    fi

    admin_key_list=$($garage_cmd key list 2>/dev/null \
        | grep -w "$BENCHMARK_STORE_ACCESS_KEY" \
        | tail -n+1 | awk '{print $1}')

    if [ -n "$admin_key_list" ]; then
        echo "Deleting existing admin access keys..." >&2
        for admin_key in $admin_key_list; do
            $garage_cmd key delete --yes $admin_key >/dev/null 2>&1
        done
    else
        echo "No admin keys to delete; skipping." >&2
    fi

    echo "Creating admin access key..." >&2
    create_key_output=$($garage_cmd key create admin 2>/dev/null)
    store_access_key=$(printf "%s\n" "$create_key_output" | grep "Key ID:" | awk '{print $3}')
    store_secret_key=$(printf "%s\n" "$create_key_output" | grep "Secret key:" | awk '{print $3}')

    if $garage_cmd bucket list 2>/dev/null | grep -q -w "{{warp_bucket}}"; then
        echo "Warp bucket exists; skipping." >&2
    else
        echo "Creating warp bucket..." >&2
        $garage_cmd bucket create "{{warp_bucket}}" >/dev/null 2>&1
    fi

    echo "Granting read/write permissions to admin..." >&2
    $garage_cmd bucket allow --read --write --owner "{{warp_bucket}}" --key "$store_access_key" >/dev/null 2>&1

    printf "%s %s\n" "$store_access_key" "$store_secret_key"

[group("helpers")]
garage: check-deps
    #!/bin/bash -e

    eval $(cd .. && just print-env)

    host="$BENCHMARK_HOST"
    port=$BENCHMARK_PORTS_GARAGE

    (cd .. && just check-port "${host}" "${port}")

    echo "Benchmarking Garage..."

    credentials=$(just garage-init 2>/dev/null | tail -n1)
    access_key=$(echo $credentials | cut -d' ' -f1)
    secret_key=$(echo $credentials | cut -d' ' -f2)

    export MC_HOST_bench="http://${access_key}:${secret_key}@${host}:${port}"
    mc mb -p bench/{{warp_bucket}}

    export WARP_HOST="${host}:${port}"
    export WARP_ACCESS_KEY="$access_key"
    export WARP_SECRET_KEY="$secret_key"
    export WARP_REGION="$BENCHMARK_STORE_REGION"
    export WARP_TLS="$BENCHMARK_STORE_TLS"

    OUTPUT_DIR="output/garage"
    echo "Output dir set to ${OUTPUT_DIR}."

    cd {{warp_dir}}
    mkdir -p $OUTPUT_DIR
    cd $OUTPUT_DIR
    warp run ../../config.yml
    echo

[group("main")]
store id: check-deps
    #!/bin/bash -e

    eval $(cd .. && just print-env)

    case {{lowercase(id)}} in
        dev)
            host="localhost"
            port=6789
            ;;
        labstore)
            host="$BENCHMARK_HOST"
            port=$BENCHMARK_PORTS_LABSTORE
            ;;
        minio)
            host="$BENCHMARK_HOST"
            port=$BENCHMARK_PORTS_MINIO
            ;;
        garage)
            just garage-init
            just garage
            exit 0
            ;;
        seaweedfs)
            host="$BENCHMARK_HOST"
            port=$BENCHMARK_PORTS_SEAWEEDFS
            ;;
        rustfs)
            host="$BENCHMARK_HOST"
            port=$BENCHMARK_PORTS_RUSTFS
            ;;
        *)
            echo "Invalid ID {{id}}; exiting..."
            exit 2
    esac

    (cd .. && just check-port "${host}" "${port}")

    echo "Benchmarking {{id}}..."

    access_key="$BENCHMARK_STORE_ACCESS_KEY"
    secret_key="$BENCHMARK_STORE_SECRET_KEY"

    export MC_HOST_bench="http://${access_key}:${secret_key}@${host}:${port}"
    mc mb -p bench/{{warp_bucket}}

    export WARP_HOST="${host}:${port}"
    export WARP_ACCESS_KEY="$BENCHMARK_STORE_ACCESS_KEY"
    export WARP_SECRET_KEY="$BENCHMARK_STORE_SECRET_KEY"
    export WARP_REGION="$BENCHMARK_STORE_REGION"
    export WARP_TLS="$BENCHMARK_STORE_TLS"

    OUTPUT_DIR="output/{{lowercase(id)}}"
    echo "Output dir set to ${OUTPUT_DIR}."

    cd {{warp_dir}}
    mkdir -p $OUTPUT_DIR
    cd $OUTPUT_DIR
    warp run ../../config.yml
    echo

[group("main")]
stores:
    just store LabStore
    just store MinIO
    just store Garage
    just store SeaweedFS
    just store RustFS

[group("analysis")]
analysis-sql model: check-deps
    cat {{join(analysis_dir, model + ".sql")}} | duckdb {{analysis_db}}

[group("analysis")]
analysis-view op:
    @column -s, -t {{join(analysis_dir, "output/op_stats-" + lowercase(op) + ".csv")}}

[group("analysis")]
analysis-plot: check-deps
    termgraph {{join(analysis_dir, "output/op_stats.dat")}} \
        --color black red yellow cyan blue \
        --title "Operations per second" \
        --space-between

[group("analysis")]
analysis:
    mkdir -p {{join(analysis_dir, "output")}}
    just analysis-sql load
    just analysis-sql summary
    just analysis-plot

[group("analysis")]
analysis-db: check-deps
    duckdb {{analysis_db}}

all: bandwidth stores analysis

clean:
    rm -rf {{join(warp_dir, "output")}}
    rm -rf {{join(iperf3_dir, "output")}}
    rm -rf {{join(analysis_dir, "output")}}
